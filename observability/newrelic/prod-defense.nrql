-- Read-only. Account 8718557 (US). Adjust UTC window for the demonstration.
-- Recent ingestion does not prove an alert or human reception.
SELECT count(*), latest(timestamp)
FROM SystemSample, SnippetSwarmSample, SnippetStorageSample,
  PostgresqlInstanceSample, PostgresqlDatabaseSample, PgCustomQuerySample,
  Transaction, Span, Log
WHERE environment = 'prod' OR label.environment = 'prod' OR appName LIKE '%(prod)%'
FACET eventType() SINCE 20 minutes ago LIMIT MAX

SELECT latest(running), latest(desired), latest(imageState), latest(timestamp)
FROM SnippetSwarmSample WHERE environment = 'prod'
FACET service SINCE 20 minutes ago LIMIT MAX

SELECT latest(up), latest(contentOk), latest(reason), latest(timestamp)
FROM SnippetStorageSample WHERE environment = 'prod' AND up IS NOT NULL
FACET service SINCE 20 minutes ago

SELECT count(*), latest(timestamp)
FROM PageView, PageViewTiming, BrowserInteraction, JavaScriptError
WHERE appName = 'snippet-searcher-prod-ui'
FACET eventType() SINCE 30 minutes ago

SELECT latest(result), latest(timestamp)
FROM SyntheticCheck WHERE monitorName LIKE 'snippet-searcher-prod-%'
FACET monitorName, location SINCE 1 hour ago

SELECT latest(result), latest(failureCategory), latest(timestamp)
FROM SnippetFunctionalCheck WHERE environment = 'prod'
FACET checkName SINCE 1 day ago

-- Historical UI drill: physical recovery 13:56:17.979Z, close event 14:01:43.733Z.
-- Signal openTime/closeTime differ from event processing timestamps.
SELECT timestamp, conditionName, event, incidentId, incidentLink, openTime, closeTime, targetName
FROM NrAiIncident
WHERE conditionName = 'PROD - Servicio del stack sin replicas disponibles'
SINCE '2026-11-23 13:49:00 +0000' UNTIL '2026-11-23 14:10:00 +0000' LIMIT 100

SELECT timestamp, destinationType, status, operation, trigger, workflowName, issueLink, notificationResult
FROM NrAiNotification
WHERE workflowName = 'snippet-searcher-prod-disponibilidad'
SINCE '2026-11-23 13:49:00 +0000' UNTIL '2026-11-23 14:10:00 +0000' LIMIT 100
