proxy_set_header Connection "";
proxy_set_header Forwarded "";
proxy_set_header Host "${PROXY_HOSTNAME}:${PROXY_PUBLIC_PORT}";
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Host "${PROXY_HOSTNAME}:${PROXY_PUBLIC_PORT}";
proxy_set_header X-Forwarded-Port "${PROXY_PUBLIC_PORT}";
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Server "${PROXY_HOSTNAME}";
proxy_set_header X-Forwarded-Ssl "";
proxy_set_header X-Forwarded-Prefix $external_prefix;
proxy_set_header X-Request-ID $request_id;
proxy_hide_header X-Request-ID;
add_header X-Request-ID $request_id always;

location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "nginx-up\n";
}

location = /api {
    return 308 /api/$is_args$args;
}

location /api/ {
    proxy_pass http://snippets_backend/;
}

location /api/executions/ {
    proxy_buffering off;
    gzip off;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-store" always;
    add_header X-Request-ID $request_id always;
    proxy_pass http://snippets_backend/executions/;
}

location / {
    proxy_pass http://ui_backend;
}
