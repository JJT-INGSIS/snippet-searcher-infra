[Unit]
Description=Chequeo funcional autenticado de Snippet Searcher DEV
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/snippet-observability/dev/functional-auth0.json

[Service]
Type=oneshot
UMask=0077
LimitCORE=0
TimeoutStartSec=4min
ExecStart=/usr/bin/python3 -B /opt/snippet-observability/dev/functional/run.py
