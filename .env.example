# Local Docker build credentials. Fill these values only in your .env.
GITHUB_ACTOR=ThiagoSere
GITHUB_TOKEN=

# Independent passwords for the two local databases.
SNIPPETS_DB_PASSWORD=
PERMISSIONS_DB_PASSWORD=

# Optional local port overrides if the defaults are unavailable.
SNIPPETS_DB_PORT=5432
PERMISSIONS_DB_PORT=5433

# Optional HTTP destinations used by Snippets and the verification container.
# Use service names and internal ports for the shared Docker environment.
PERMISSIONS_BASE_URL=http://permissions-service:8080
PRINTSCRIPT_BASE_URL=http://printscript-service:8080

# SNI-33. Start the runtime with --profile assets; provider remains local until
# an explicitly approved cutover. Never switch an existing environment blindly.
STORAGE_PROVIDER=local
STORAGE_ASSET_BASE_URL=http://asset-service:8080
STORAGE_ASSET_CONTAINER=snippets
STORAGE_ASSET_CONNECT_TIMEOUT=2s
STORAGE_ASSET_READ_TIMEOUT=5s
STORAGE_ASSET_MAX_CONTENT_BYTES=1048576

# SNI-38: optional local HTTP entry point. No certificates or Azure changes.
PROXY_HOSTNAME=localhost
PROXY_HTTP_PORT=8088
# Canonical port exposed to the browser; keep aligned with PROXY_HTTP_PORT locally.
PROXY_PUBLIC_PORT=8088

# SNI-42: public dev identity for the optional ui profile; empty disables it.
UI_DEV_ACTOR=
